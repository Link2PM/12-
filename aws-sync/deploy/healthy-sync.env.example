# Copy to /etc/healthy-sync.env, replace the placeholder, then chmod 600.
# Never commit the real file.
HEALTHY_SYNC_SECRET=REPLACE_WITH_A_RANDOM_SECRET
HEALTHY_SYNC_USER_KEY=link
HEALTHY_SYNC_DB=/var/lib/healthy-sync/healthy-sync.sqlite3
HEALTHY_SYNC_HOST=127.0.0.1
HEALTHY_SYNC_PORT=8787
HEALTHY_ALLOWED_ORIGINS=https://health.gaindar.com
